# Copy this file to .env and uncomment/fill in your API keys
# You can also manage these keys directly in the GUI via the "API Keys" dialog.

# NVIDIA NIM
# NVIDIA_API_KEY="nvapi-your-nvidia-api-key"
# NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
# NVIDIA_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"

# ChatGPT (OpenAI)
# OPENAI_API_KEY="sk-your-openai-api-key"
# OPENAI_MODEL="gpt-4o"
# OPENAI_BASE_URL=""

# Google Gemini (OpenAI-compatible endpoint)
# GEMINI_API_KEY="AIza-your-gemini-api-key"
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"

# Anthropic Claude (OpenAI-compatible endpoint)
# ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1/"

# xAI Grok
# XAI_API_KEY="xai-your-grok-api-key"
# XAI_MODEL="grok-3"
# XAI_BASE_URL="https://api.x.ai/v1"

# Custom / Local OpenAI-compatible server (Ollama, vLLM, LM Studio, etc.)
# CUSTOM_BASE_URL="http://127.0.0.1:11434/v1"
# CUSTOM_API_KEY=""
# CUSTOM_MODEL="llama3.2"
